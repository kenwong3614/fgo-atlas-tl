  "148": {
    "s": "松永彈正",
    "t": "到頭來不就是那副模樣 (形/なり)嗎。"
  },
  "149": {
    "s": "松永彈正",
    "t": "那副德性是怎樣………！"
  },
  "150": {
    "s": "松永彈正",
    "t": "那是什麼樣子啊！　到底是怎麼回事！"
  },
  "151": {
    "s": "三好長慶",
    "t": "…………。"
  },
  "152": {
    "s": "松永彈正",
    "t": "那是……、我所侍奉的天下人會做得出來的事嗎……！"
  },
  "153": {
    "s": "松永彈正",
    "t": "要承認那樣的長慶 (ちょうけい)大人，\n除了是對昔日的您的背叛之外，別無其他！"
  },
  "154": {
    "s": "三好長慶",
    "t": "…………。"
  },
  "155": {
    "s": "三好長慶",
    "t": "是嗎，久秀……。"
  },
  "156": {
    "s": "三好長慶",
    "t": "我本以為，至少你不會背叛我，"
  },
  "157": {
    "s": "三好長慶",
    "t": "是嗎，久秀……、連你也……。"
  },
  "158": {
    "s": "松永彈正",
    "t": "哈……、"
  },
  "159": {
    "s": "松永彈正",
    "t": "事到如今，這久秀我就……。"
  },
  "160": {
    "s": "三好長慶",
    "t": "迄今為止你一直很好地輔佐著我啊，久秀。"
  },
  "161": {
    "s": "三好長慶",
    "t": "不過從現在起才是緊要關頭。要治理這荒蕪的人世，\n撫慰 (慰撫/い　ぶ)百姓，為世間的安寧而努力。"
  },
  "162": {
    "s": "松永久秀",
    "t": "可喜可賀至極。"
  },
  "163": {
    "s": "松永久秀",
    "t": "將軍義輝已不在京中，變得有名無實 (ゆうめいむじつ)的室町幕府，\n如今已不過是無用的長物。"
  },
  "164": {
    "s": "松永久秀",
    "t": "長慶 (ちょうけい)大人的治世 (御世/み　よ)，這松永久秀，當全力予以輔佐。"
  },
  "165": {
    "s": "三好長慶",
    "t": "如此啊……。"
  },
  "166": {
    "s": "三好長慶",
    "t": "呼……、呼哈哈哈哈哈！"
  },
  "167": {
    "s": "松永久秀",
    "t": "……這是怎麼了呢。"
  },
  "168": {
    "s": "三好長慶",
    "t": "沒什麼，只是想起你開始侍奉我的那些日子。"
  },
  "169": {
    "s": "三好長慶",
    "t": "當時年歲 (齢/よわい)尚輕的我能走到這一步，\n實在是因為有你的輔佐，久秀。"
  },
  "170": {
    "s": "松永久秀",
    "t": "這全都是長慶 (ちょうけい)大人自身的力量，久秀我這點輔佐\n不過是微不足道之物。"
  },
  "171": {
    "s": "三好長慶",
    "t": "再稍候片刻，這戰亂之世也即將結束。"
  },
  "172": {
    "s": "三好長慶",
    "t": "到那時，便能與你一同吟詠和歌、以茶為樂了吧。"
  },
  "173": {
    "s": "松永久秀",
    "t": "哦，若是要款待長慶 (ちょうけい)大人的話，\n那可得把看家本領都使出來才行啊。"
  },
  "174": {
    "s": "三好長慶",
    "t": "那可真是令人期待。"
  },
  "175": {
    "s": "三好長慶",
    "t": "……啊，再一點點，再忍耐一點點就好。"
  },
  "176": {
    "s": "三好長慶",
    "t": "我就拜託你了，久秀。"
  },
  "177": {
    "s": "松永久秀",
    "t": "是……、這久秀我……！"
  },
  "178": {
    "s": "松永彈正",
    "t": "就讓我來為您送上『引導』吧！"
  }
}
